DATA_DIR=data
# Symbols are declared per asset class. The full per-exchange subscription list
# is CRYPTO + COMMODITY. Commodity perps (metals/energy) trade ~5 days/week, so
# they are exempted from the weekend WebDAV sync check; crypto (24/7) is not.
# The *_COMMODITY_* lists are optional (leave empty if none).
BINANCE_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT
BINANCE_COMMODITY_SYMBOLS=XAUUSDT,XAGUSDT,CLUSDT
BYBIT_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
BYBIT_COMMODITY_SYMBOLS=XAUUSDT,XAGUSDT,CLUSDT
LOG_LEVEL=INFO
WS_TEST_MODE=false
LOCAL_STORAGE_MB=1024
WEBDAV_USER=example@mail.ru
WEBDAV_PASSWORD=example_password
WEBDAV_URL=https://webdav.cloud.mail.ru
# Optional second WebDAV for redundant backup
# WEBDAV2_USER=example@yandex.ru
# WEBDAV2_PASSWORD=example_password
# WEBDAV2_URL=https://webdav.yandex.ru
